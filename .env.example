MONGO_URI=mongodb+srv://username:password@example.mongodb.net/ambisense
PORT=1234
JWT_SECRET=remplacez-par-une-longue-valeur-aleatoire
REMOTE_ACCESS=http://adresse-ip-du-telephone:8080
API_KEY=cle-api-generee-par-post-devices
# Origine(s) du client autorisees par CORS (separees par des virgules).
# Vide en local = toutes origines. En production, mettre l'URL du frontend deploye.
CLIENT_ORIGIN=
# Fuseau utilise pour regrouper les mesures par heure (recommandations).
APP_TIMEZONE=America/Toronto
